<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="ae7557b6-f195-4c80-86e9-4cefc7d97453" author="Belikov-V">
        <comment>Create USER_DATA table</comment>
        <createTable tableName="USER_DATA">
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="EMAIL" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="FIRST_NAME" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="LAST_NAME" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="PHOTO_ID" type="UUID"/>
            <column name="CREATION_DATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_MODIFICATION_DATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="ca978e06-0065-45d7-9f48-69b05f6669cb" author="Belikov-V">
        <comment>Create USR table</comment>
        <createTable tableName="USR">
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="EMAIL" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="PASSWORD" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="ROLE" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="CREATION_DATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_MODIFICATION_DATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="a9d23d94-541a-4a62-a855-2db70f042926" author="Belikov-V">
        <comment>Add FK USR.EMAIL -> USER_DATA.EMAIL (one-to-one)</comment>
        <addForeignKeyConstraint
                baseTableName="USR"
                baseColumnNames="EMAIL"
                referencedTableName="USER_DATA"
                referencedColumnNames="EMAIL"
                constraintName="fk_usr_userData"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="bbc8ce0b-afe1-4465-aa79-757d394681da" author="Belikov-V">
        <comment>Create COURSE table</comment>
        <createTable tableName="COURSE">
            <column name="ID" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="TITLE" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="PRICE" type="DECIMAL(12,2)"/>
            <column name="PHOTO_ID" type="UUID"/>
            <column name="STATUS" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="CREATION_DATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_MODIFICATION_DATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="76765c7d-bb1f-41d2-aae1-2d13bc78f7a6" author="Belikov-V">
        <comment>Create SECTION table</comment>
        <createTable tableName="SECTION">
            <column name="ID" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="TITLE" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="COURSE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="STATUS" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="ORDER_NUMBER" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATION_DATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_MODIFICATION_DATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="55d324d0-1483-404d-83bc-5fa5176bc3da" author="Belikov-V">
        <comment>Add FK SECTION.COURSE_ID -> COURSE.ID (many-to-one)</comment>
        <addForeignKeyConstraint
                baseTableName="SECTION"
                baseColumnNames="COURSE_ID"
                referencedTableName="COURSE"
                referencedColumnNames="ID"
                constraintName="fk_section_course"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="79a9f6ff-5e8f-407e-8b70-e9a09f4bd956" author="Belikov-V">
        <comment>Create LECTURE table</comment>
        <createTable tableName="LECTURE">
            <column name="ID" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="TITLE" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="SECTION_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CONTENT_ID" type="UUID"/>
            <column name="STATUS" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="ORDER_NUMBER" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATION_DATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_MODIFICATION_DATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="88b05d32-f828-49b5-a818-e109be477689" author="Belikov-V">
        <comment>Add FK LECTURE.SECTION_ID -> SECTION.ID (many-to-one)</comment>
        <addForeignKeyConstraint
                baseTableName="LECTURE"
                baseColumnNames="SECTION_ID"
                referencedTableName="SECTION"
                referencedColumnNames="ID"
                constraintName="fk_lecture_section"/>
    </changeSet>
</databaseChangeLog>

